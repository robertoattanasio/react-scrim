{
  "name": "react-scrim",
  "version": "0.1.0",
  "description": "CSS-native scrim for React: a covering layer whose state is data attributes, so the animation stays in your stylesheet.",
  "keywords": [
    "react",
    "scrim",
    "overlay",
    "curtain",
    "transition",
    "route-transition",
    "css",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://dev.robertoattanasio.com/react-scrim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/react-scrim.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/react-scrim/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "css.d.ts"
  ],
  "workspaces": [
    "."
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm pack && changeset publish && git push --follow-tags"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
