{
  "name": "react-scrim",
  "version": "0.4.0",
  "description": "A scrim store for React: declare the nodes and how they animate once, then cover and uncover from anywhere, route loaders included.",
  "keywords": [
    "react",
    "scrim",
    "overlay",
    "curtain",
    "transition",
    "route-transition",
    "web-animations",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://dev.robertoattanasio.com/react-scrim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/react-scrim.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/react-scrim/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "workspaces": [
    "."
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm pack && changeset publish && git push --follow-tags"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
